      "copy": {
        "en": {
          "name": "Mara Marshward",
          "concept": "Warden, archer, tracker",
          "role": "Scout, ranged damage, tracker",
          "background": "Mara grew up on the edge of a vast swamp. She learned to read tracks, move silently through difficult terrain, and survive for days with little gear. Her younger brother vanished following strange tracks into the marsh—she never accepted that he simply died.",
          "motivation": "Find her missing brother and learn what took him.",
          "personality": "Quiet, observant, practical. Trusts tracks over rumours. Uneasy in crowded settlements."
        },
        "nl": {
          "name": "Mara Veldkind",
          "concept": "Woudloper, boogschutter, spoorzoeker",
          "role": "Verkenner, afstandsschade, spoorzoeker",
          "background": "Mara groeide op aan de rand van een uitgestrekt moeras. Ze leerde sporen lezen, stil door moeilijk terrein bewegen en dagenlang met weinig uitrusting overleven. Haar jongere broer verdween na vreemde sporen het moeras in—ze heeft nooit geaccepteerd dat hij simpelweg stierf.",
          "motivation": "Haar verdwenen broer vinden en ontdekken wat hem wegnam.",
          "personality": "Stil, oplettend, praktisch. Vertrouwt sporen boven geruchten. Ongemakkelijk in drukke nederzettingen."
        }
      },
